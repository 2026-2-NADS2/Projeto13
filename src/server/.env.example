# ============================================================
# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O .env NÃO vai para o GitHub (está no .gitignore): é onde ficam
# as credenciais, que nunca podem aparecer no código-fonte.
# ============================================================

# Porta da API. No Render, ela é definida automaticamente.
PORT=3000

# Banco de dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=kfka

# SSL: no computador e no Railway, deixe false. Só provedores que
# exigem certificado (como o Aiven) usam DB_SSL=true e o texto do
# "CA certificate" em DB_SSL_CA (começa com -----BEGIN CERTIFICATE-----).
DB_SSL=false
DB_SSL_CA=

# Chave secreta que assina os tokens de login (JWT).
# Use um texto longo e aleatório. Para gerar um no terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Se alguém descobrir esta chave, consegue criar tokens falsos.
JWT_SECRET=troque_por_um_texto_longo_e_aleatorio

# Por quanto tempo o login vale (requisito: sessões com expiração).
JWT_EXPIRA=2h

# Endereço do front-end que pode chamar esta API (CORS).
# Em desenvolvimento é o Vite; em produção, a URL do Netlify.
CORS_ORIGIN=http://localhost:5173
